<Window x:Class="BCSH2_SEM.View.NotesWindow"
        x:Name="NotesWindowRoot"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:local="clr-namespace:BCSH2_SEM.View"
        xmlns:uc="clr-namespace:BCSH2_SEM.View.UserControls"
        xmlns:cv="clr-namespace:BCSH2_SEM.ViewModel.Converters"
        xmlns:helpers="clr-namespace:BCSH2_SEM.ViewModel.Helpers"
        mc:Ignorable="d"
        Title="NotesWindow" Height="450" Width="800">

    <Window.Resources>
        <helpers:BindingProxy x:Key="ViewModelProxy" Data="{Binding DataContext, ElementName=NotesWindowRoot}" />
    </Window.Resources>

    <DockPanel x:Name="container">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem Header="New notebook"
                          Command="{Binding NewNotebookCommand}"/>
                <MenuItem Header="New note"
                          Command="{Binding NewNoteCommand}"
                          CommandParameter="{Binding SelectedNotebook}"/>
                <Separator/>
                <MenuItem Header="Exit"
                          Click="MenuItem_Click"/>
            </MenuItem>
        </Menu>
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="statusTextBlock"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Search Bars -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10">
            <TextBlock Text="Search Notebooks:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox Width="200" 
                     Margin="0,0,20,0"
                     Text="{Binding NotebookSearchText, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Search Notes:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox Width="200" 
                     Text="{Binding NoteSearchText, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <!-- ListView for Notebooks -->
        <ListView Width="140"
                  Background="MidnightBlue"
                  DockPanel.Dock="Left"
                  SelectedItem="{Binding SelectedNotebook, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  ItemsSource="{Binding NotebooksView}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <uc:NotebookControl DisplayNotebook="{Binding}"/>
                        <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisConverter}}"
                                 KeyDown="NotebookNameTextBox_KeyDown">
                            <!-- Додаємо обробник KeyDown -->
                            <b:Interaction.Triggers>
                                <b:EventTrigger EventName="LostFocus">
                                    <b:InvokeCommandAction Command="{Binding Data.HasRenamedCommand, Source={StaticResource ViewModelProxy}}"
                                                           CommandParameter="{Binding}"/>
                                </b:EventTrigger>
                            </b:Interaction.Triggers>
                        </TextBox>

                        <Grid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Rename"
                                          Command="{Binding Data.BeginEditCommand, Source={StaticResource ViewModelProxy}}"
                                          CommandParameter="{Binding}"/>
                                <MenuItem Header="Delete"
                                          Command="{Binding Data.DeleteNotebookCommand, Source={StaticResource ViewModelProxy}}"
                                          CommandParameter="{Binding}"/>
                            </ContextMenu>
                        </Grid.ContextMenu>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>


        <!-- ListView for Notes -->
        <ListView Width="200"
                  DockPanel.Dock="Left"
                  SelectedItem="{Binding SelectedNote, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  ItemsSource="{Binding NotesView}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <!-- Display Control -->
                        <uc:NoteControl Note="{Binding}"
                                        Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisConverter}}" />

                        <!-- Editable TextBox for Notes -->
                        <TextBox Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisConverter}}"
                                 MinWidth="150" Padding="5">
                            <b:Interaction.Triggers>
                                <b:EventTrigger EventName="LostFocus">
                                    <b:InvokeCommandAction Command="{Binding DataContext.SaveEditedNoteCommand, ElementName=NotesWindowRoot}"
                                                           CommandParameter="{Binding}" />
                                </b:EventTrigger>
                            </b:Interaction.Triggers>
                        </TextBox>

                        <!-- Context Menu -->
                        <Grid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Rename"
                                          Command="{Binding Data.BeginEditNoteCommand, Source={StaticResource ViewModelProxy}}"
                                          CommandParameter="{Binding}" />
                                <MenuItem Header="Delete"
                                          Command="{Binding Data.DeleteNoteCommand, Source={StaticResource ViewModelProxy}}"
                                          CommandParameter="{Binding}" />
                            </ContextMenu>
                        </Grid.ContextMenu>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Toolbar -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <ToggleButton x:Name="boldButton"
                              Click="boldButton_Click">
                    <TextBlock Text="B"
                               FontWeight="Bold"/>
                </ToggleButton>
                <ToggleButton x:Name="italicButton"
                              Click="italicButton_Click">
                    <TextBlock Text="I"
                               FontStyle="Italic"/>
                </ToggleButton>
                <ToggleButton x:Name="underlineButton"
                              Click="underlineButton_Click">
                    <TextBlock Text="U"
                               TextDecorations="Underline"/>
                </ToggleButton>
                <ComboBox x:Name="fontFamilyComboBox"
                          Width="100"
                          SelectionChanged="fontFamilyComboBox_SelectionChanged"/>
                <ComboBox x:Name="fontSizeComboBox"
                          Width="50"
                          IsEditable="True"
                          TextBoxBase.TextChanged="fontSizeComboBox_TextChanged"/>
                <Button Content="Save"
                        x:Name="saveFileButton"
                        Click="saveFileButton_Click"/>
            </ToolBar>
        </ToolBarTray>

        <!-- RichTextBox -->
        <Grid>
            <RichTextBox x:Name="contentRichTextBox"
                         SelectionChanged="contentRichTextBox_SelectionChanged"
                         TextChanged="contentRichTextBox_TextChanged"/>
        </Grid>
    </DockPanel>
</Window>
